# Full Docker development stack. Copy to .env at the repository root.
COMPOSE_PROJECT_NAME=recallcam
COMPOSE_BIND_ADDRESS=127.0.0.1
APP_IMAGE=recallcam-app:dev
FRONT_IMAGE=recallcam-front:dev
PYTHON_IMAGE=python:3.12-slim-bookworm
NODE_IMAGE=node:22-bookworm-slim
FRONT_PORT=3000
BACKEND_PORT=8000
# Browser -> frontend origin -> Next.js proxy -> backend service.
NEXT_PUBLIC_API_BASE_URL=
BACKEND_INTERNAL_URL=http://backend:8000
FRONT_WATCH_POLLING=false
POSTGRES_IMAGE=postgres:18.6-alpine
POSTGRES_PORT=5432
POSTGRES_DB=recallcam
POSTGRES_USER=recallcam
POSTGRES_PASSWORD=recallcam-local-development
REDIS_IMAGE=redis:8.10.2-alpine
REDIS_PORT=6379
QDRANT_IMAGE=qdrant/qdrant:v1.19.2
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
SILO_IMAGE=pgsty/silo:RELEASE.2026-10-18T00-00-00Z
SILO_API_PORT=9000
SILO_CONSOLE_PORT=9001
SILO_ROOT_USER=recallcam-admin
SILO_ROOT_PASSWORD=recallcam-local-development-only
S3_BUCKET=recallcam

# Internal service ports stay fixed even when published host ports change.
# URL-encode reserved characters in DATABASE_URL credentials.
DATABASE_URL=postgresql://recallcam:recallcam-local-development@postgres:5432/recallcam
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://object-storage:9000
S3_ACCESS_KEY_ID=recallcam-admin
S3_SECRET_ACCESS_KEY=recallcam-local-development-only
S3_REGION=us-east-1
# Reachable by the browser; keep distinct from the Docker-only S3_ENDPOINT_URL.
# If SILO_API_PORT changes, update this URL too. For a remote team server use its host.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
MEDIA_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES=10737418240
UPLOAD_TIMEOUT_SECONDS=3600
MEDIA_PROBE_TIMEOUT_SECONDS=30
MEDIA_PREVIEW_TIMEOUT_SECONDS=20
# Explicitly queued playback copies: wall-clock timeout, CPU threads and output size cap.
PLAYBACK_CONVERSION_TIMEOUT_SECONDS=7200
PLAYBACK_CONVERSION_THREADS=2
PLAYBACK_CONVERSION_MAX_BYTES=21474836480
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
BACKEND_PROXY_TIMEOUT_SECONDS=3600
# Compose supplies /app/data using a volume shared by backend and worker.
DATA_DIR=/app/data
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM/VLM stay native, outside Docker. Use a reachable host/IP for remote services.
# Native LM Studio base URL excludes /api/v1/chat.
# An OpenAI-compatible base URL normally ends with /v1.
VLM_API_STYLE=lmstudio-native
VLM_BASE_URL=http://host.docker.internal:1234
VLM_MODEL_ID=qwen3-vl-4b-instruct-mlx
VLM_API_KEY=
VLM_TIMEOUT_SECONDS=180
LLM_API_STYLE=openai-compatible
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL_ID=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
CV_DEVICE=auto
EMBEDDING_DEVICE=auto
INDEXING_CONCURRENCY=1


# Stateless JWT authentication. Generate a private key of at least 32 random bytes.
# Example (requires only Docker):
# docker run --rm python:3.12-slim-bookworm python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=
JWT_ISSUER=recallcam
JWT_AUDIENCE=recallcam-api
JWT_ACCESS_TOKEN_MINUTES=60
