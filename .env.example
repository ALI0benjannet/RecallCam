# Local development infrastructure. Copy to .env at the repository root.
COMPOSE_PROJECT_NAME=recallcam
COMPOSE_BIND_ADDRESS=127.0.0.1
POSTGRES_IMAGE=postgres:18.6-alpine
POSTGRES_PORT=5432
POSTGRES_DB=recallcam
POSTGRES_USER=recallcam
POSTGRES_PASSWORD=recallcam-local-development
REDIS_IMAGE=redis:8.10.2-alpine
REDIS_PORT=6379
QDRANT_IMAGE=qdrant/qdrant:v1.19.2
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
SILO_IMAGE=pgsty/silo:RELEASE.2026-10-18T00-00-00Z
SILO_API_PORT=9000
SILO_CONSOLE_PORT=9001
SILO_ROOT_USER=recallcam-admin
SILO_ROOT_PASSWORD=recallcam-local-development-only
S3_BUCKET=recallcam

# Application processes run on the host in this scaffold.
# Keep URLs in sync with the infrastructure ports/credentials above.
DATABASE_URL=postgresql://recallcam:recallcam-local-development@127.0.0.1:5432/recallcam
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=recallcam-admin
S3_SECRET_ACCESS_KEY=recallcam-local-development-only
S3_REGION=us-east-1
DATA_DIR=./data
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Native LM Studio base URL excludes /api/v1/chat.
# An OpenAI-compatible base URL normally ends with /v1.
VLM_API_STYLE=lmstudio-native
VLM_BASE_URL=http://127.0.0.1:1234
VLM_MODEL_ID=qwen3-vl-4b-instruct-mlx
VLM_API_KEY=
VLM_TIMEOUT_SECONDS=180
LLM_API_STYLE=openai-compatible
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL_ID=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
CV_DEVICE=auto
EMBEDDING_DEVICE=auto
INDEXING_CONCURRENCY=1

